# Application
APP_NAME=BeauTrend API
APP_VERSION=1.0.0
API_PREFIX=/api
DEBUG=true

# Database (SQLite by default; swap for postgresql://... in production)
DATABASE_URL=sqlite:///./data/beautytrend.db

# Comma-separated or JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
